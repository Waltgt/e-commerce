{
  "openapi": "3.0.3",
  "info": {
    "title": "Sistema E-Commerce — API",
    "version": "1.0.0",
    "description": "API REST del sistema de comercio electrónico (Práctica 2). Todas las respuestas siguen el formato { success, data } o { success: false, error: { code, message } }."
  },
  "servers": [
    { "url": "/api", "description": "Relativo al host actual (desarrollo o producción)" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token obtenido en /auth/login, /auth/google o /auth/refresh"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "VALIDATION_ERROR" },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "tags": [
    { "name": "Auth", "description": "Registro, login local y con Google, sesión, recuperación de contraseña" },
    { "name": "Productos", "description": "Catálogo público y administración de productos e imágenes" },
    { "name": "Categorías", "description": "Categorías de producto" },
    { "name": "Carrito", "description": "Carrito de compras del usuario autenticado" },
    { "name": "Pedidos", "description": "Checkout, pago simulado e historial de pedidos" },
    { "name": "Admin — Usuarios", "description": "Gestión de cuentas de usuario" },
    { "name": "Reseñas", "description": "Reseñas de producto y su moderación" }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Registrar un nuevo usuario (rol CUSTOMER)",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["name", "email", "password"], "properties": { "name": { "type": "string" }, "email": { "type": "string", "format": "email" }, "password": { "type": "string", "minLength": 8, "description": "Mínimo 8 caracteres, al menos una letra y un número" } } } } }
        },
        "responses": {
          "201": { "description": "Usuario creado" },
          "409": { "description": "El correo ya está registrado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Iniciar sesión con correo y contraseña",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["email", "password"], "properties": { "email": { "type": "string" }, "password": { "type": "string" } } } } }
        },
        "responses": {
          "200": { "description": "accessToken emitido; el refresh token se envía como cookie httpOnly" },
          "401": { "description": "Credenciales inválidas" },
          "403": { "description": "Usuario bloqueado" }
        }
      }
    },
    "/auth/google": {
      "post": {
        "tags": ["Auth"],
        "summary": "Iniciar sesión o registrarse con un id_token de Google",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["idToken"], "properties": { "idToken": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "accessToken emitido" }, "401": { "description": "Token de Google inválido o correo no verificado" } }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Renovar el access token usando la cookie de refresh token",
        "responses": { "200": { "description": "Nuevo accessToken, el refresh token rota" }, "401": { "description": "Sesión inválida o expirada" } }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Cerrar sesión y revocar el refresh token actual",
        "responses": { "200": { "description": "Sesión cerrada" } }
      }
    },
    "/auth/password-reset/request": {
      "post": {
        "tags": ["Auth"],
        "summary": "Solicitar enlace de recuperación de contraseña por correo",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["email"], "properties": { "email": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Respuesta genérica, exista o no el correo (no revela si está registrado)" } }
      }
    },
    "/auth/password-reset/confirm": {
      "post": {
        "tags": ["Auth"],
        "summary": "Confirmar el restablecimiento con el token recibido por correo",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["token", "newPassword"], "properties": { "token": { "type": "string" }, "newPassword": { "type": "string", "minLength": 8 } } } } } },
        "responses": { "200": { "description": "Contraseña actualizada; se revocan todas las sesiones activas del usuario" }, "400": { "description": "Token inválido o expirado" } }
      }
    },
    "/products": {
      "get": {
        "tags": ["Productos"],
        "summary": "Listar productos (público), con búsqueda, filtros y paginación",
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "categoryId", "in": "query", "schema": { "type": "integer" } },
          { "name": "minPrice", "in": "query", "schema": { "type": "number" } },
          { "name": "maxPrice", "in": "query", "schema": { "type": "number" } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["newest", "popularity", "price_asc", "price_desc"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 50 } },
          { "name": "includeInactive", "in": "query", "schema": { "type": "boolean" }, "description": "Solo tiene efecto si quien hace la petición es ADMIN autenticado" }
        ],
        "responses": { "200": { "description": "Listado paginado, con imageIds, categorías y conteo de compras (popularidad). Respuesta cacheada en Redis." } }
      },
      "post": {
        "tags": ["Productos"],
        "summary": "Crear un producto",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["name", "description", "price", "stock", "categoryIds"], "properties": { "name": { "type": "string" }, "description": { "type": "string" }, "price": { "type": "number" }, "stock": { "type": "integer" }, "lowStockThreshold": { "type": "integer" }, "categoryIds": { "type": "array", "items": { "type": "integer" } } } } } } },
        "responses": { "201": { "description": "Producto creado" }, "401": { "description": "No autenticado" }, "403": { "description": "Requiere rol ADMIN" } }
      }
    },
    "/products/categories": {
      "get": { "tags": ["Categorías"], "summary": "Listar categorías (público, cacheado en Redis)", "responses": { "200": { "description": "OK" } } },
      "post": {
        "tags": ["Categorías"],
        "summary": "Crear una categoría",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } } } } },
        "responses": { "201": { "description": "Categoría creada" }, "409": { "description": "Ya existe" } }
      }
    },
    "/products/{id}": {
      "get": {
        "tags": ["Productos"],
        "summary": "Obtener detalle de un producto (público)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Incluye promedio y conteo de reseñas visibles" }, "404": { "description": "No encontrado" } }
      },
      "put": {
        "tags": ["Productos"],
        "summary": "Actualizar un producto",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Actualizado" }, "403": { "description": "Requiere rol ADMIN" } }
      },
      "delete": {
        "tags": ["Productos"],
        "summary": "Desactivar un producto (borrado lógico)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Desactivado" }, "403": { "description": "Requiere rol ADMIN" } }
      }
    },
    "/products/{id}/reactivate": {
      "post": {
        "tags": ["Productos"],
        "summary": "Reactivar un producto previamente desactivado",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Reactivado" }, "403": { "description": "Requiere rol ADMIN" } }
      }
    },
    "/products/{id}/images": {
      "post": {
        "tags": ["Productos"],
        "summary": "Subir una o más imágenes a un producto (máximo 5, 1MB c/u, JPEG/PNG/WEBP)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "images": { "type": "array", "items": { "type": "string", "format": "binary" } } } } } } },
        "responses": { "201": { "description": "Imágenes agregadas" }, "403": { "description": "Requiere rol ADMIN" } }
      }
    },
    "/products/{id}/images/{imageId}": {
      "get": {
        "tags": ["Productos"],
        "summary": "Obtener el binario de una imagen de producto (público)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }, { "name": "imageId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Imagen (image/jpeg, image/png o image/webp)" }, "404": { "description": "No encontrada" } }
      },
      "delete": {
        "tags": ["Productos"],
        "summary": "Eliminar una imagen de producto",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }, { "name": "imageId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Eliminada" }, "403": { "description": "Requiere rol ADMIN" } }
      }
    },
    "/cart": {
      "get": { "tags": ["Carrito"], "summary": "Obtener el carrito del usuario autenticado", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Incluye disponibilidad real de cada ítem y si puede pasar a checkout (canCheckout)" } } },
      "delete": { "tags": ["Carrito"], "summary": "Vaciar el carrito", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Vaciado" } } }
    },
    "/cart/items": {
      "post": {
        "tags": ["Carrito"],
        "summary": "Agregar un producto al carrito (suma cantidad si ya existe)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["productId", "quantity"], "properties": { "productId": { "type": "integer" }, "quantity": { "type": "integer", "minimum": 1 } } } } } },
        "responses": { "201": { "description": "Agregado" }, "400": { "description": "Stock insuficiente o producto no disponible" } }
      }
    },
    "/cart/items/{productId}": {
      "put": {
        "tags": ["Carrito"],
        "summary": "Actualizar la cantidad de un ítem del carrito",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "productId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["quantity"], "properties": { "quantity": { "type": "integer", "minimum": 1 } } } } } },
        "responses": { "200": { "description": "Actualizado" } }
      },
      "delete": {
        "tags": ["Carrito"],
        "summary": "Quitar un producto del carrito",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "productId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Eliminado" } }
      }
    },
    "/orders/checkout": {
      "post": {
        "tags": ["Pedidos"],
        "summary": "Confirmar el pedido con el carrito actual y procesar el pago simulado",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["paymentMethod"], "properties": { "paymentMethod": { "type": "string", "enum": ["CREDIT_CARD", "PAYPAL", "CASH"] }, "cardNumber": { "type": "string", "description": "Solo para CREDIT_CARD. Un número terminado en 0000 simula un pago rechazado." } } } } }
        },
        "responses": {
          "201": { "description": "status: PAID (stock descontado, carrito vaciado, correo de confirmación enviado) o PAYMENT_REJECTED (carrito se conserva)" },
          "400": { "description": "Carrito vacío, producto no disponible o stock insuficiente" }
        }
      }
    },
    "/orders": {
      "get": { "tags": ["Pedidos"], "summary": "Historial de pedidos del usuario autenticado", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },
    "/orders/{id}": {
      "get": {
        "tags": ["Pedidos"],
        "summary": "Detalle de un pedido propio",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" }, "404": { "description": "No encontrado" } }
      }
    },
    "/admin/users": {
      "get": { "tags": ["Admin — Usuarios"], "summary": "Listar usuarios", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Requiere rol ADMIN" }, "403": { "description": "Requiere rol ADMIN" } } }
    },
    "/admin/users/{id}": {
      "get": {
        "tags": ["Admin — Usuarios"],
        "summary": "Detalle de un usuario, incluyendo su historial de pedidos",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" }, "404": { "description": "No encontrado" } }
      }
    },
    "/admin/users/{id}/block": {
      "post": {
        "tags": ["Admin — Usuarios"],
        "summary": "Bloquear una cuenta (revoca sus sesiones activas de inmediato)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Bloqueado" }, "400": { "description": "Un admin no puede bloquearse a sí mismo" } }
      }
    },
    "/admin/users/{id}/unblock": {
      "post": {
        "tags": ["Admin — Usuarios"],
        "summary": "Desbloquear una cuenta",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Desbloqueado" } }
      }
    },
    "/products/{id}/reviews": {
      "get": {
        "tags": ["Reseñas"],
        "summary": "Listar reseñas visibles de un producto (público)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Reseñas"],
        "summary": "Crear una reseña (solo si el usuario compró el producto)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["rating", "comment"], "properties": { "rating": { "type": "integer", "minimum": 1, "maximum": 5 }, "comment": { "type": "string" } } } } } },
        "responses": { "201": { "description": "Creada" }, "403": { "description": "El usuario no compró este producto" } }
      }
    },
    "/admin/reviews": {
      "get": {
        "tags": ["Reseñas"],
        "summary": "Listar todas las reseñas del sistema (visibles y ocultas), paginado",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }, { "name": "pageSize", "in": "query", "schema": { "type": "integer", "default": 20 } }],
        "responses": { "200": { "description": "Requiere rol ADMIN" } }
      }
    },
    "/admin/reviews/{id}/hide": {
      "patch": {
        "tags": ["Reseñas"],
        "summary": "Ocultar una reseña (no la elimina)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Ocultada" } }
      }
    },
    "/admin/reviews/{id}/unhide": {
      "patch": {
        "tags": ["Reseñas"],
        "summary": "Restaurar una reseña oculta",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Restaurada" } }
      }
    },
    "/admin/reviews/{id}": {
      "delete": {
        "tags": ["Reseñas"],
        "summary": "Eliminar una reseña permanentemente",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Eliminada" } }
      }
    }
  }
}